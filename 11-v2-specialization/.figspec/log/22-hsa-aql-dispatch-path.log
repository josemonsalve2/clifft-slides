+  <text x="1058" y="84" fill="#9ba3b8" font-family="Arial, sans-serif" font-size="9.5" text-anchor="end">persistent resources · done once</text>
+
+  <!-- Persistent resource creation -->
+  <rect x="34" y="94" width="280" height="32" rx="6" fill="#00cc66" fill-opacity="0.09" stroke="#00cc66" stroke-opacity="0.70"/>
+  <text x="174" y="108" fill="#dfe3ed" font-family="monospace" font-size="9.5" text-anchor="middle">hsa_amd_memory_pool_allocate</text>
+  <text x="174" y="120" fill="#67f0a9" font-family="Arial, sans-serif" font-size="9" font-weight="700" text-anchor="middle">kernarg · done once</text>
+
+  <rect x="326" y="94" width="264" height="32" rx="6" fill="#00cc66" fill-opacity="0.09" stroke="#00cc66" stroke-opacity="0.70"/>
+  <text x="458" y="108" fill="#dfe3ed" font-family="monospace" font-size="9.5" text-anchor="middle">hsa_amd_agents_allow_access</text>
+  <text x="458" y="120" fill="#67f0a9" font-family="Arial, sans-serif" font-size="9" font-weight="700" text-anchor="middle">GPU access · done once</text>
+
+  <rect x="602" y="94" width="184" height="32" rx="6" fill="#00cc66" fill-opacity="0.09" stroke="#00cc66" stroke-opacity="0.70"/>
