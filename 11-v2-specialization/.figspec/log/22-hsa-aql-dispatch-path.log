+  <text x="379" y="259" fill="#ff7777" font-family="Arial, sans-serif" font-size="9" font-weight="700" text-anchor="middle">runtime</text>
+  <text x="379" y="270" fill="#ff7777" font-family="Arial, sans-serif" font-size="9" font-weight="700" text-anchor="middle">round-trip</text>
+
+  <rect x="34" y="296" width="316" height="42" rx="7" fill="#cc2222" fill-opacity="0.13" stroke="#cc2222" stroke-width="1.5"/>
+  <text x="48" y="313" fill="#ff7777" font-family="monospace" font-size="9.5">hsa_signal_create</text>
+  <text x="48" y="328" fill="#dfe3ed" font-family="Arial, sans-serif" font-size="9">new completion signal</text>
+  <path d="M350 317 H355 M403 317 H408" fill="none" stroke="#cc2222" stroke-width="1.7" marker-end="url(#arrowRed)"/>
+  <rect x="355" y="296" width="48" height="31" rx="4" fill="#0d0d1a"/>
+  <text x="379" y="309" fill="#ff7777" font-family="Arial, sans-serif" font-size="9" font-weight="700" text-anchor="middle">runtime</text>
+  <text x="379" y="320" fill="#ff7777" font-family="Arial, sans-serif" font-size="9" font-weight="700" text-anchor="middle">round-trip</text>
+
+  <text x="34" y="356" fill="#ff7777" font-family="Arial, sans-serif" font-size="10.5" font-weight="700">3 allocations + 1 access grant, every dispatch</text>
