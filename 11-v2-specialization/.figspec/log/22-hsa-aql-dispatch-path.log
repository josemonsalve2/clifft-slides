+  <text x="379" y="208" fill="#ff7777" font-family="Arial, sans-serif" font-size="9" font-weight="700" text-anchor="middle">runtime</text>
+  <text x="379" y="219" fill="#ff7777" font-family="Arial, sans-serif" font-size="9" font-weight="700" text-anchor="middle">round-trip</text>
+
+  <rect x="34" y="246" width="316" height="42" rx="7" fill="#cc2222" fill-opacity="0.13" stroke="#cc2222" stroke-width="1.5"/>
+  <text x="48" y="263" fill="#ff7777" font-family="monospace" font-size="9.5">hsa_amd_agents_allow_access</text>
+  <text x="48" y="278" fill="#dfe3ed" font-family="Arial, sans-serif" font-size="9">authorize GPU access</text>
+  <path d="M350 267 H355 M403 267 H408" fill="none" stroke="#cc2222" stroke-width="1.7" marker-end="url(#arrowRed)"/>
