    <rect x="327" y="390" width="190" height="50" rx="7" fill="#cc2222" fill-opacity="0.14" stroke="#cc2222"/>
    <text x="422" y="410" fill="#ffaaaa" font-family="monospace">sample_branch</text>
    <text x="422" y="422" fill="#ffaaaa">compares against a</text>
    <text x="422" y="434" fill="#ffaaaa">corrupted probability</text>
    <line x1="517" y1="415" x2="533" y2="415" stroke="#53d8fb" stroke-width="1.5" marker-end="url(#arrowCyan)"/>

    <rect x="539" y="395" width="139" height="40" rx="7" fill="#cc2222" fill-opacity="0.12" stroke="#cc2222"/>
    <text x="608.5" y="419" fill="#ffaaaa">takes the other branch</text>
    <line x1="678" y1="415" x2="694" y2="415" stroke="#53d8fb" stroke-width="1.5" marker-end="url(#arrowCyan)"/>

    <rect x="700" y="390" width="166" height="50" rx="7" fill="#cc2222" fill-opacity="0.10" stroke="#cc2222"/>
    <text x="783" y="412" fill="#ffaaaa">consumes a different</text>
    <text x="783" y="426" fill="#ffaaaa">number of PRNG draws</text>
    <line x1="866" y1="415" x2="882" y2="415" stroke="#53d8fb" stroke-width="1.5" marker-end="url(#arrowCyan)"/>

    <rect x="888" y="390" width="187" height="50" rx="7" fill="#e94560" fill-opacity="0.16" stroke="#e94560"/>
    <text x="981.5" y="410" fill="#ffffff" font-weight="700">the two backends never</text>
