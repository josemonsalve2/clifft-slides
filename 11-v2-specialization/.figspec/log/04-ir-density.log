  <text x="201" y="218" fill="#ddaa66" font-family="monospace" font-size="8" text-anchor="middle">Qubit activation</text>
  <text x="201" y="232" fill="#aa8844" font-family="monospace" font-size="7" text-anchor="middle">state vector grow</text>
  <text x="201" y="246" fill="#aa8844" font-family="monospace" font-size="7" text-anchor="middle">ancilla init</text>
  <text x="201" y="260" fill="#aa8844" font-family="monospace" font-size="7" text-anchor="middle">memory alloc</text>
