+    <text x="574" y="162">// The 32 GB budget keeps the pool sane at both ends on a 288 GB MI355X.</text>
+    <text x="574" y="177" fill="#ffffff">const uint64_t amp = 1ull &lt;&lt; flat.peak_rank;</text>
+    <text x="574" y="192" fill="#ffffff">const uint64_t bytes_per_wg = amp * sizeof(GpuComplex) + (amp / 2) * sizeof(GpuComplex);</text>
+    <text x="574" y="207" fill="#ffffff">const uint64_t budget = 32ull &lt;&lt; 30;  // 32 GB</text>
+    <text x="574" y="222" fill="#ffffff">uint64_t wgs = budget / bytes_per_wg;</text>
+    <text x="574" y="237" fill="#ffffff">if (wgs &lt; 1) wgs = 1;               // rank 26+: at least one resident wg</text>
+    <text x="574" y="252" fill="#ffffff">if (wgs &gt; 2048) wgs = 2048;</text>
+    <text x="574" y="267" fill="#ffffff">global_grid_wgs = static_cast&lt;uint32_t&gt;(wgs);</text>
