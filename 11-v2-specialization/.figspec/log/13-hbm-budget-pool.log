  <text x="400" y="139" fill="#44dd44" font-family="monospace" font-size="10" text-anchor="middle" font-weight="bold">Persistent kernel: workgroups stay resident on CUs — no re-launch overhead between shots</text>

  <!-- ═══════════════════════════════════════════════ MIDDLE — PHASES ══ -->
  <rect x="8" y="178" width="784" height="122" rx="6" fill="#1e1218" stroke="#5a3040" stroke-width="1"/>

  <!-- 6 phase boxes -->
  <!-- Phase 1: Frame -->
  <rect x="16" y="186" width="118" height="106" rx="4" fill="#2a1a00" stroke="#ff8c00" stroke-width="1.5"/>
