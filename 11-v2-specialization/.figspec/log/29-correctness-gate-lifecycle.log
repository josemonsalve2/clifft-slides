+
+  <rect width="1100" height="620" fill="#1a1a2e"/>
+  <path d="M0 61 H1100 M0 294 H1100 M0 568 H1100" stroke="#ffffff" stroke-opacity="0.07"/>
+  <path d="M24 0 V568 M1076 0 V568" stroke="#ffffff" stroke-opacity="0.025"/>
+
+  <!-- Title -->
+  <text x="550" y="31" fill="#ffffff" font-family="Arial, sans-serif" font-size="21" font-weight="700" text-anchor="middle">Compile Once, Validate Once, Then Choose</text>
+  <text x="550" y="50" fill="#aeb4c7" font-family="Arial, sans-serif" font-size="11" text-anchor="middle">And why a correctness check on the measurement path becomes a performance number</text>
+
+  <!-- Later-run fast path -->
+  <path d="M118 94 V78 H946 V94" fill="none" stroke="#53d8fb" stroke-width="1.5" stroke-dasharray="5 5" marker-end="url(#arrowCyan)"/>
+  <rect x="390" y="66" width="286" height="18" rx="9" fill="#0d0d1a" stroke="#53d8fb" stroke-opacity="0.55"/>
+  <text x="533" y="78.5" fill="#9cecff" font-family="Arial, sans-serif" font-size="10" font-weight="700" text-anchor="middle">disk cache hit — the verdict is computed once ever</text>
+
+  <!-- Shape key -->
+  <rect x="24" y="94" width="188" height="184" rx="10" fill="url(#cyanFill)" stroke="#53d8fb" stroke-width="2"/>
+  <rect x="24" y="94" width="188" height="29" rx="9" fill="#53d8fb" fill-opacity="0.20"/>
+  <text x="118" y="113" fill="#9cecff" font-family="Arial, sans-serif" font-size="12" font-weight="700" text-anchor="middle">SHAPE KEY</text>
+  <text x="118" y="140" fill="#ffffff" font-family="monospace" font-size="11" font-weight="700" text-anchor="middle">tname + "_r" +</text>
+  <text x="118" y="156" fill="#ffffff" font-family="monospace" font-size="11" font-weight="700" text-anchor="middle">peak_rank + "_n" +</text>
+  <text x="118" y="172" fill="#ffffff" font-family="monospace" font-size="11" font-weight="700" text-anchor="middle">num_instrs</text>
+  <text x="118" y="189" fill="#9ba3b8" font-family="monospace" font-size="9" text-anchor="middle">v2_kernel.cc:366-367</text>
+  <rect x="35" y="198" width="166" height="70" rx="6" fill="#0d0d1a" fill-opacity="0.72" stroke="#53d8fb" stroke-opacity="0.45"/>
+  <text x="43" y="211" fill="#dfe3ed" font-family="Arial, sans-serif" font-size="9">The key is circuit shape,</text>
+  <text x="43" y="224" fill="#dfe3ed" font-family="Arial, sans-serif" font-size="9">not circuit name.</text>
+  <text x="43" y="237" fill="#dfe3ed" font-family="Arial, sans-serif" font-size="9">One binary and verdict</text>
+  <text x="43" y="250" fill="#dfe3ed" font-family="Arial, sans-serif" font-size="9">are shared by a family.</text>
+  <text x="43" y="263" fill="#dfe3ed" font-family="Arial, sans-serif" font-size="9">A failure affects it at once.</text>
+
