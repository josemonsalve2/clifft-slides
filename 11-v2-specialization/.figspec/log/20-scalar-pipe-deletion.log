+    <text x="916" y="255" fill="#ff8e8e" font-weight="700" text-anchor="middle">8</text>
+    <text x="980" y="255" fill="#67f0a9" font-weight="700" text-anchor="middle">3</text>
+
+    <rect x="760" y="264" width="244" height="27" fill="#cc2222" fill-opacity="0.05"/>
+    <text x="768" y="282" fill="#dfe3ed">SGPRs</text>
