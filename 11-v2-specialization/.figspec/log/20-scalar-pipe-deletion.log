+  <rect x="888" y="338" width="116" height="39" rx="7" fill="#53d8fb" fill-opacity="0.11" stroke="#53d8fb"/>
+  <text x="946" y="354" fill="#ffffff" font-family="Arial, sans-serif" font-size="13" font-weight="700" text-anchor="middle">5.50× fewer</text>
+  <text x="946" y="369" fill="#dfe3ed" font-family="Arial, sans-serif" font-size="9.5" text-anchor="middle">VALU</text>
+
+  <!-- Counter-intuitive point -->
+  <rect x="24" y="420" width="992" height="116" rx="10" fill="#53d8fb" fill-opacity="0.08" stroke="#53d8fb" stroke-width="1.5"/>
+  <line x1="548" y1="436" x2="548" y2="520" stroke="#53d8fb" stroke-opacity="0.28"/>
+
+  <rect x="40" y="436" width="138" height="20" rx="10" fill="#53d8fb" fill-opacity="0.18"/>
+  <text x="109" y="450" fill="#53d8fb" font-family="Arial, sans-serif" font-size="10" font-weight="700" text-anchor="middle">BOTH PIPES FALL</text>
+  <text x="40" y="477" fill="#ffffff" font-family="Arial, sans-serif" font-size="13" font-weight="700">SALU drops 74 → 35 and VALU drops 44 → 8.</text>
+  <text x="40" y="498" fill="#dfe3ed" font-family="Arial, sans-serif" font-size="11.5">Nothing migrates from one pipe to the other — there is simply less of both.</text>
+  <text x="40" y="518" fill="#9ba3b8" font-family="Arial, sans-serif" font-size="10">The work disappears; it does not move from VALU to SALU.</text>
+
+  <rect x="570" y="436" width="164" height="20" rx="10" fill="#53d8fb" fill-opacity="0.18"/>
+  <text x="652" y="450" fill="#53d8fb" font-family="Arial, sans-serif" font-size="10" font-weight="700" text-anchor="middle">ACROSS THE CORPUS</text>
+  <text x="570" y="477" fill="#ffffff" font-family="Arial, sans-serif" font-size="13" font-weight="700">26 of 26 circuits: SALU ratio below VALU ratio.</text>
+  <text x="570" y="498" fill="#dfe3ed" font-family="Arial, sans-serif" font-size="11.5">SALU ratio range 0.110 – 0.361.</text>
+  <text x="570" y="518" fill="#9ba3b8" font-family="Arial, sans-serif" font-size="10">Fewer scalar instructions throughout the corpus.</text>
+
+  <!-- Punchline -->
+  <rect x="24" y="552" width="992" height="34" rx="8" fill="#e94560" fill-opacity="0.13" stroke="#e94560"/>
+  <text x="520" y="574" fill="#ffffff" font-family="Arial, sans-serif" font-size="12.5" font-weight="700" text-anchor="middle">Specialization removes the serial prerequisites before useful arithmetic begins.</text>
+</svg>

