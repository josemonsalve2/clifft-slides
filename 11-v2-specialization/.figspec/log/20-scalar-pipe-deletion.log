+  <title id="title">Specialization Deletes a Dependency Chain, Not Just Instructions</title>
+  <desc id="desc">Two aligned instruction lanes compare the interpreter's serial operand-fetch dependency chain with a specialized path that embeds the operand as a literal and reaches useful arithmetic immediately. A count table and callout show that both scalar and vector instruction counts fall.</desc>
+
+  <defs>
+    <linearGradient id="interpreterFill" x1="0" y1="0" x2="0" y2="1">
+      <stop offset="0" stop-color="#cc2222" stop-opacity="0.25"/>
+      <stop offset="1" stop-color="#cc2222" stop-opacity="0.08"/>
+    </linearGradient>
+    <linearGradient id="specializedFill" x1="0" y1="0" x2="0" y2="1">
+      <stop offset="0" stop-color="#00cc66" stop-opacity="0.23"/>
+      <stop offset="1" stop-color="#00cc66" stop-opacity="0.07"/>
+    </linearGradient>
+    <linearGradient id="workFill" x1="0" y1="0" x2="0" y2="1">
+      <stop offset="0" stop-color="#53d8fb" stop-opacity="0.22"/>
+      <stop offset="1" stop-color="#53d8fb" stop-opacity="0.07"/>
+    </linearGradient>
+    <pattern id="stallHatch" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
+      <rect width="8" height="8" fill="#cc2222" fill-opacity="0.10"/>
+      <line x1="0" y1="0" x2="0" y2="8" stroke="#ff7777" stroke-width="2" stroke-opacity="0.28"/>
+    </pattern>
+    <filter id="glowRed" x="-30%" y="-30%" width="160%" height="160%">
+      <feGaussianBlur stdDeviation="2.5" result="blur"/>
