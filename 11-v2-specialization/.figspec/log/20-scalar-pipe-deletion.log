+  <text x="537" y="143" fill="#ffffff" font-family="monospace" font-size="9" font-weight="700" text-anchor="middle">s_waitcnt</text>
+  <text x="537" y="157" fill="#dfe3ed" font-family="monospace" font-size="9" text-anchor="middle">lgkmcnt(0)</text>
+  <rect x="513" y="168" width="48" height="17" rx="8.5" fill="#cc2222" fill-opacity="0.45"/>
+  <text x="537" y="180" fill="#ffffff" font-family="Arial, sans-serif" font-size="9" font-weight="700" text-anchor="middle">STALL</text>
+
+  <!-- Switch dispatch -->
+  <line x1="580" y1="158" x2="586" y2="158" stroke="#cc2222" stroke-width="2" marker-end="url(#arrowRed)"/>
+  <rect x="588" y="125" width="76" height="66" rx="12" fill="url(#interpreterFill)" stroke="#cc2222" stroke-width="1.5"/>
+  <text x="626" y="146" fill="#ffffff" font-family="monospace" font-size="9" font-weight="700" text-anchor="middle">s_cmp /</text>
+  <text x="626" y="160" fill="#ffffff" font-family="monospace" font-size="9" font-weight="700" text-anchor="middle">s_cbranch</text>
+  <text x="626" y="180" fill="#ff8e8e" font-family="Arial, sans-serif" font-size="9" font-weight="700" text-anchor="middle">SALU · switch</text>
