+  <text x="122" y="322" fill="#ffffff" font-family="monospace" font-size="10" font-weight="700" text-anchor="middle">s_mov_b32 s4, 0x2A</text>
+  <text x="122" y="341" fill="#67f0a9" font-family="Arial, sans-serif" font-size="9.5" font-weight="700" text-anchor="middle">literal in instruction stream</text>
+  <text x="122" y="356" fill="#dfe3ed" font-family="Arial, sans-serif" font-size="9" text-anchor="middle">no load · no wait</text>
+
+  <!-- Immediate useful arithmetic -->
+  <line x1="208" y1="333" x2="236" y2="333" stroke="#00cc66" stroke-width="2" marker-end="url(#arrowGreen)"/>
+  <rect x="244" y="300" width="100" height="66" rx="12" fill="url(#workFill)" stroke="#53d8fb" stroke-width="2"/>
+  <text x="294" y="326" fill="#ffffff" font-family="monospace" font-size="10" font-weight="700" text-anchor="middle">v_fma_f32</text>
+  <text x="294" y="344" fill="#53d8fb" font-family="Arial, sans-serif" font-size="9.5" font-weight="700" text-anchor="middle">same useful</text>
+  <text x="294" y="357" fill="#dfe3ed" font-family="Arial, sans-serif" font-size="9" text-anchor="middle">arithmetic</text>
+
+  <!-- Deleted span -->
+  <line x1="358" y1="333" x2="718" y2="333" stroke="#00cc66" stroke-width="1.5" stroke-opacity="0.30" stroke-dasharray="5 6"/>
+  <path d="M358 350 V356 Q358 362 364 362 H530 Q538 362 538 370 Q538 362 546 362 H712 Q718 362 718 356 V350" fill="none" stroke="#00cc66" stroke-width="1.5"/>
+  <rect x="500" y="368" width="76" height="19" rx="9.5" fill="#00cc66" fill-opacity="0.16"/>
+  <text x="538" y="381.5" fill="#67f0a9" font-family="Arial, sans-serif" font-size="10.5" font-weight="700" text-anchor="middle">deleted</text>
+
+  <!-- S1 count table -->
+  <rect x="748" y="76" width="268" height="320" rx="10" fill="#0d0d1a" fill-opacity="0.72" stroke="#ffffff" stroke-opacity="0.10"/>
+  <text x="764" y="99" fill="#ffffff" font-family="Arial, sans-serif" font-size="13" font-weight="700">S1 · frame operand folding</text>
+  <text x="764" y="115" fill="#9ba3b8" font-family="Arial, sans-serif" font-size="9.5" font-weight="700" letter-spacing="0.7">REGISTER TIER · MEASURED COUNTS</text>
+
+  <rect x="760" y="128" width="244" height="28" rx="5" fill="#ffffff" fill-opacity="0.06"/>
