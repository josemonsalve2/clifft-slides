+    <text x="980" y="201" fill="#67f0a9" font-weight="700" text-anchor="middle">8</text>
+
+    <rect x="760" y="210" width="244" height="27" fill="#cc2222" fill-opacity="0.05"/>
+    <text x="768" y="228" fill="#dfe3ed">SALU</text>
+    <text x="916" y="228" fill="#ff8e8e" font-weight="700" text-anchor="middle">74</text>
+    <text x="980" y="228" fill="#67f0a9" font-weight="700" text-anchor="middle">35</text>
+
