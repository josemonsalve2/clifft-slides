+  <circle cx="51" cy="275" r="4" fill="#00cc66" filter="url(#glowGreen)"/>
+  <text x="62" y="279" fill="#67f0a9" font-family="Arial, sans-serif" font-size="11" font-weight="700">SPECIALIZED</text>
+  <text x="718" y="279" fill="#9ba3b8" font-family="Arial, sans-serif" font-size="9.5" text-anchor="end">same horizontal scale</text>
+
+  <!-- Literal operand -->
