+  <text x="702" y="167" fill="#53d8fb" font-family="Arial, sans-serif" font-size="9" font-weight="700" text-anchor="middle">VALU</text>
+  <text x="702" y="181" fill="#dfe3ed" font-family="Arial, sans-serif" font-size="9" text-anchor="middle">useful work</text>
+
