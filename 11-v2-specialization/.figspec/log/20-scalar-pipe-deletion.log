+  <rect x="496" y="119" width="82" height="78" rx="13" fill="url(#stallHatch)" stroke="#ff5555" stroke-width="2" stroke-dasharray="4 3"/>
+  <text x="537" y="143" fill="#ffffff" font-family="monospace" font-size="9" font-weight="700" text-anchor="middle">s_waitcnt</text>
