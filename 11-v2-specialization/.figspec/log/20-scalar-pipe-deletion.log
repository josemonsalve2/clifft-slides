+  <text x="447" y="177" fill="#ff8e8e" font-family="Arial, sans-serif" font-size="9" font-weight="700" text-anchor="middle">dependent</text>
+  <text x="447" y="188" fill="#aeb4c7" font-family="Arial, sans-serif" font-size="9" text-anchor="middle">memory</text>
+
+  <!-- Second stall -->
