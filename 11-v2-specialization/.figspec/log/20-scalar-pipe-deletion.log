+  <rect x="408" y="125" width="78" height="66" rx="12" fill="url(#interpreterFill)" stroke="#cc2222" stroke-width="1.5"/>
+  <text x="447" y="146" fill="#ffffff" font-family="monospace" font-size="9" font-weight="700" text-anchor="middle">s_load_</text>
