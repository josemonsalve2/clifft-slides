  <!-- ═══════════════════════════════════════════════ MIDDLE — PHASES ══ -->
  <rect x="8" y="178" width="784" height="122" rx="6" fill="#1e1218" stroke="#5a3040" stroke-width="1"/>

  <!-- 6 phase boxes -->
  <!-- Phase 1: Frame -->
