+  </g>
+
+  <!-- Punchline -->
+  <rect x="20" y="558" width="1060" height="48" rx="10" fill="#e94560" fill-opacity="0.14" stroke="#e94560"/>
+  <text x="550" y="588" fill="#ffffff" font-family="Arial, sans-serif" font-size="13" font-weight="700" text-anchor="middle">The bodies still contain their own loops. Only the operands became constants.</text>
