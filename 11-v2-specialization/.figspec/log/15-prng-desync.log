+    <text x="48" y="119" fill="#9ba3b8">// The clamp decision must match the SVM's on every call: a branch clamped on</text>
+    <text x="48" y="137" fill="#9ba3b8">// one side and rolled on the other consumes a PRNG draw the other never did,</text>
+    <text x="48" y="155" fill="#9ba3b8">// and the two streams never resynchronize. See V2_DUST_EPS.</text>
+    <text x="48" y="180" fill="#ffffff">static inline u8 sample_branch(u64* rng, double p0, double p1, double total) {</text>
+    <text x="48" y="198" fill="#dfe3ed">    double eps = V2_DUST_EPS * total;</text>
+    <text x="48" y="206" fill="#e94560" font-weight="700">    if (p1 &lt;= eps) return 0;          // &lt;-- returns WITHOUT drawing</text>
