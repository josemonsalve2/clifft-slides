  <desc id="desc">An A/B decomposition of V1 f64 instruction volume, including the unchanged f32 control, the complete experiment table, the scratch tradeoff, and the differing log linkage mechanism.</desc>

  <defs>
    <linearGradient id="logFill" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#cc2222" stop-opacity="0.88"/>
      <stop offset="1" stop-color="#cc2222" stop-opacity="0.48"/>
    </linearGradient>
    <linearGradient id="baseFill" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#aeb4c7" stop-opacity="0.64"/>
      <stop offset="1" stop-color="#9ba3b8" stop-opacity="0.28"/>
    </linearGradient>
    <linearGradient id="controlFill" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#53d8fb" stop-opacity="0.42"/>
      <stop offset="1" stop-color="#53d8fb" stop-opacity="0.12"/>
