      <path d="M0,0 L8,4 L0,8 Z" fill="#53d8fb"/>
    </marker>
  </defs>

  <rect width="1100" height="620" fill="#1a1a2e"/>
  <path d="M0 62 H1100 M0 357 H1100 M0 559 H1100" stroke="#ffffff" stroke-opacity="0.07"/>
  <path d="M22 0 V620 M1078 0 V620" stroke="#ffffff" stroke-opacity="0.025"/>

  <!-- Title -->
  <text x="550" y="31" fill="#ffffff" font-family="Arial, sans-serif" font-size="21" font-weight="700" text-anchor="middle">Where V1's 4,347 f64 Instructions Come From</text>
  <text x="550" y="50" fill="#aeb4c7" font-family="Arial, sans-serif" font-size="11" text-anchor="middle">A/B on V1's own stage-3 IR through V1's own pipeline (opt -O2 | llc -O2) · one variable changed</text>

  <!-- Attribution panel -->
  <g>
