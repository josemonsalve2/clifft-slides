    <line x1="50" y1="104" x2="400" y2="104" stroke="#ffffff" stroke-opacity="0.08"/>

    <!-- f64 stacked bar -->
    <text x="120" y="120" fill="#dfe3ed" font-family="Arial, sans-serif" font-size="10.5" font-weight="700" text-anchor="middle">v_f64 total · 4,347</text>
