    <rect x="45" y="399" width="475" height="92" rx="7" fill="#00cc66" fill-opacity="0.06" stroke="#00cc66" stroke-opacity="0.68"/>
    <text x="60" y="418" fill="#67f0a9" font-family="Arial, sans-serif" font-size="10.5" font-weight="700">V2 (<tspan font-family="monospace">v2_ops.h</tspan>)</text>
    <g fill="#dfe3ed" font-family="monospace" font-size="9.3">
      <text x="60" y="439">static inline double cnorm(CV2Complex v) {</text>
      <text x="60" y="456">    double re = (double)v.re, im = (double)v.im; return re * re + im * im;</text>
      <text x="60" y="473">}</text>
    </g>

    <!-- V1 quote -->
    <rect x="535" y="399" width="520" height="92" rx="7" fill="#cc2222" fill-opacity="0.06" stroke="#cc2222" stroke-opacity="0.70"/>
    <text x="550" y="418" fill="#ff7777" font-family="Arial, sans-serif" font-size="10.5" font-weight="700">V1 (<tspan font-family="monospace">mlir_emit.cc:826</tspan>, inside <tspan font-family="monospace">emit_cnorm</tspan>)</text>
    <g fill="#dfe3ed" font-family="monospace" font-size="9">
      <text x="550" y="437">// Match gold cnorm (hip_sampler.hip): extend each f32 component to f64,</text>
      <text x="550" y="449">// then square and sum in f64. Squaring in f32 first (then extending) loses</text>
      <text x="550" y="461">// precision and flips borderline stabilizer measurement branches on</text>
      <text x="550" y="473">// RNG-path-dependent shots.</text>
    </g>

    <!-- Linkage asymmetry -->
    <rect x="45" y="500" width="1010" height="44" rx="7" fill="#53d8fb" fill-opacity="0.08" stroke="#53d8fb" stroke-opacity="0.58"/>
    <text x="550" y="519" fill="#ffffff" font-family="Arial, sans-serif" font-size="11.5" font-weight="700" text-anchor="middle">V2 links ROCm device bitcode and calls <tspan font-family="monospace" fill="#53d8fb">__ocml_log_f64</tspan>; V1 had no such link and had to write the polynomial in MLIR.</text>
    <text x="550" y="537" fill="#dfe3ed" font-family="Arial, sans-serif" font-size="10.5" text-anchor="middle">Exact attribution: <tspan font-family="monospace" fill="#53d8fb">0x3FD5555555555555</tspan> is unique to that polynomial and occurs 54 times.</text>
  </g>

  <!-- Punchline -->
