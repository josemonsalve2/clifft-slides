    <rect x="455" y="238" width="281" height="30" rx="15" fill="#53d8fb" fill-opacity="0.10" stroke="#53d8fb" stroke-opacity="0.65"/>
    <text x="595.5" y="258" fill="#53d8fb" font-family="Arial, sans-serif" font-size="11" font-weight="700" text-anchor="middle">total instructions moved · 5,527</text>
    <rect x="748" y="238" width="309" height="30" rx="15" fill="#cc2222" fill-opacity="0.13" stroke="#cc2222" stroke-opacity="0.75"/>
    <text x="902.5" y="258" fill="#ff8e8e" font-family="Arial, sans-serif" font-size="11" font-weight="700" text-anchor="middle">log_expansions · 54 → 1</text>

