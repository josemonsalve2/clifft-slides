      <text x="520" y="177">12038</text>
      <text x="600" y="177">11148</text>
      <text x="669" y="177">1380</text>
      <text x="716" y="177">1586</text>
      <text x="773" y="177">0</text>
      <text x="843" y="177">477</text>
      <text x="921" y="177">224</text>
      <text x="1011" y="177">1</text>
