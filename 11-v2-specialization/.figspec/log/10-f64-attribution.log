    <rect x="448" y="133" width="609" height="26" fill="#cc2222" fill-opacity="0.08"/>
    <rect x="448" y="159" width="609" height="26" fill="#e94560" fill-opacity="0.07"/>

    <g fill="#aeb4c7" font-family="monospace" font-size="9" font-weight="700" text-anchor="middle">
      <text x="469" y="124">variant</text>
      <text x="520" y="124">isa_lines</text>
      <text x="600" y="124">isa_total_instrs</text>
      <text x="669" y="124">v_f64</text>
      <text x="716" y="124">v_f32</text>
