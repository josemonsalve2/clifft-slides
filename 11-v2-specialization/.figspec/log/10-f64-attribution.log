    <text x="355" y="147" fill="#aeb4c7" font-family="Arial, sans-serif" font-size="10" font-weight="700" text-anchor="middle">B</text>
    <rect x="246" y="157" width="58" height="80" rx="7" fill="url(#controlFill)" stroke="#53d8fb"/>
    <rect x="326" y="157" width="58" height="80" rx="7" fill="url(#controlFill)" stroke="#53d8fb"/>
    <text x="275" y="202" fill="#ffffff" font-family="Arial, sans-serif" font-size="14" font-weight="700" text-anchor="middle">1,586</text>
    <text x="355" y="202" fill="#ffffff" font-family="Arial, sans-serif" font-size="14" font-weight="700" text-anchor="middle">1,586</text>
    <line x1="235" y1="247" x2="395" y2="247" stroke="#53d8fb" stroke-opacity="0.55" stroke-dasharray="3 4"/>
    <text x="315" y="272" fill="#53d8fb" font-family="Arial, sans-serif" font-size="10" font-weight="700" text-anchor="middle">the amplitude arithmetic</text>
    <text x="315" y="289" fill="#53d8fb" font-family="Arial, sans-serif" font-size="10" font-weight="700" text-anchor="middle">never moved</text>

    <rect x="50" y="318" width="350" height="20" rx="10" fill="#aeb4c7" fill-opacity="0.07" stroke="#aeb4c7" stroke-opacity="0.25"/>
    <text x="225" y="332" fill="#dfe3ed" font-family="Arial, sans-serif" font-size="9.5" text-anchor="middle">The irreducible 1,380 are the same sites V2 also has.</text>
  </g>

  <!-- Experiment table panel -->
  <g>
    <rect x="435" y="72" width="635" height="278" rx="10" fill="#0d0d1a" fill-opacity="0.72" stroke="#ffffff" stroke-opacity="0.10"/>
    <text x="455" y="96" fill="#ffffff" font-family="Arial, sans-serif" font-size="13" font-weight="700">Full A/B experiment table</text>
    <line x1="455" y1="104" x2="1050" y2="104" stroke="#ffffff" stroke-opacity="0.08"/>

