      <text x="921" y="124">scratch_bytes</text>
      <text x="1011" y="124">log_expansions</text>
    </g>
    <g fill="#ffffff" font-family="monospace" font-size="10" text-anchor="middle">
      <text x="469" y="151" font-weight="700">A</text>
      <text x="520" y="151">17802</text>
