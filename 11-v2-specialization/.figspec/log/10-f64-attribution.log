    <rect x="30" y="570" width="1040" height="36" rx="9" fill="#e94560" fill-opacity="0.14" stroke="#e94560"/>
    <text x="550" y="593" fill="#ffffff" font-family="Arial, sans-serif" font-size="13" font-weight="700" text-anchor="middle">V1's 23× f64 volume was not a precision policy. It was a missing link line.</text>
  </g>
</svg>

