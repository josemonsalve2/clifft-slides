      <line x1="448" y1="133" x2="1057" y2="133"/>
      <line x1="448" y1="159" x2="1057" y2="159"/>
    </g>

    <!-- Variant definitions -->
    <text x="455" y="207" fill="#dfe3ed" font-family="Arial, sans-serif" font-size="9.5"><tspan fill="#ff7777" font-weight="700">A</tspan><tspan> — as-is · asserted to reproduce </tspan><tspan font-family="monospace">v1/circuit_d3.5_isa.s</tspan><tspan> byte-for-byte</tspan></text>
    <text x="455" y="224" fill="#dfe3ed" font-family="Arial, sans-serif" font-size="9.5"><tspan fill="#e94560" font-weight="700">B</tspan><tspan> — </tspan><tspan font-family="monospace">clifft_log</tspan><tspan> + </tspan><tspan font-family="monospace">clifft_draw_next_noise</tspan><tspan> noinline · same amplitude arithmetic, same PRNG</tspan></text>

